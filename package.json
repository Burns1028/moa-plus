  "engines": {
    "node": ">=24.9.0"
  },
  "version": "0.1.23",
  "description": "Unofficial MoA+ for DeepSeek Harness: persistent Coordinator, reusable Workers and shared context. Preview; requires patched DSH 0.2.1-rc.3.",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh-plugin",
    "multi-agent",
    "ai-agents",
    "agent-orchestration",
    "project-management",
    "typescript"
  ],
  "license": "MIT",
  "main": "./packages/moa/lib/index.js",
  "types": "./packages/moa/lib/types/host/index.d.ts",
  "exports": {
    ".": {
      "types": "./packages/moa/lib/types/host/index.d.ts",
      "default": "./packages/moa/lib/index.js"
    },
    "./shared": {
      "types": "./packages/moa/lib/types/shared/index.d.ts",
      "default": "./packages/moa/lib/types/shared/index.js"
    },
    "./typert": {
      "types": "./packages/moa/lib/typert.host.d.ts",
      "default": "./packages/moa/lib/typert.host.js"
    },
    "./remote": {
      "types": "./packages/moa/lib/typert.remote-client.d.ts",
      "default": "./packages/moa/lib/typert.remote-client.js"
    },
    "./package.json": "./package.json",
    "./icon": "./packages/moa/assets/icon.svg",
    "./locale/*.json": "./packages/moa/locale/*.json",
    "./client": {
      "types": "./packages/moa/lib/types/client/index.d.ts",
      "default": "./packages/moa/lib/client.js"
    }
  },
  "icon": "./packages/moa/assets/icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./packages/moa/cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
