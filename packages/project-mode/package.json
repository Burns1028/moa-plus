{
  "name": "dsh-plugin-project-mode",
  "version": "0.2.2",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/types/host/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/host/index.d.ts",
      "default": "./lib/index.js"
    },
    "./shared": {
      "types": "./lib/types/shared/index.d.ts",
      "default": "./lib/types/shared/index.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./package.json": "./package.json",
    "./icon": "./assets/icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/types/shared/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "locale",
    "assets",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "lib/client.js",
    "README.zh.md",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md",
    "docs",
    "lib/typert.remote-client.d.ts.map"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": "^0.2.1-rc.3 || ^0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.3 || ^0.2.2-rc.1",
