    "@deepseek-ai/dsh-session-projection": "^0.2.1-rc.3 || ^0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "^0.2.1-rc.3 || ^0.2.2-rc.1",
    "@deepseek-ai/dsh-subagent": "^0.2.1-rc.3 || ^0.2.2-rc.1",
    "@deepseek-ai/dsh-session-query": "^0.2.1-rc.3 || ^0.2.2-rc.1",
    "@deepseek-ai/dsh-storage": "^0.2.1-rc.3 || ^0.2.2-rc.1",
    "@deepseek-ai/dsh-storage-domain": "^0.2.1-rc.3 || ^0.2.2-rc.1",
    "@deepseek-ai/dsh-working-directory": "^0.2.1-rc.3 || ^0.2.2-rc.1",
    "@deepseek-ai/dsh-fs": "^0.2.1-rc.3 || ^0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.3 || ^0.2.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "^0.2.1-rc.3 || ^0.2.2-rc.1",
    "@deepseek-ai/dsh-api-session-controller": "^0.2.1-rc.3 || ^0.2.2-rc.1",
    "@deepseek-ai/dsh-api-remote-access": "^0.2.1-rc.3 || ^0.2.2-rc.1",
    "@deepseek-ai/dsh-sandbox-policy": "^0.2.1-rc.3 || ^0.2.2-rc.1",
    "@deepseek-ai/dsh-agent-preset-registry": "^0.2.1-rc.3 || ^0.2.2-rc.1",
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/schemastery": "^3.18.5",
    "react": "^18.2.0",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.2.1-rc.3 || ^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-chat": "^0.2.1-rc.3 || ^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-workspace": "^0.2.1-rc.3 || ^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.1-rc.3 || ^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.1-rc.3 || ^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-session": "^0.2.1-rc.3 || ^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar": "^0.2.1-rc.3 || ^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-locale": "^0.2.1-rc.3 || ^0.2.2-rc.1",
    "@deepseek-ai/dsh-api-gateway": "^0.2.1-rc.3 || ^0.2.2-rc.1",
    "@deepseek-ai/dsh-api-workspace-controller": "^0.2.1-rc.3 || ^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-connection": "^0.2.1-rc.3 || ^0.2.2-rc.1",
