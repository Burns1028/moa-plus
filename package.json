  "scripts": {
    "test": "vitest run tests/host tests/client tests/integration",
    "test:native-contract": "vitest run tests/native-contract",
    "typecheck": "tsc -p packages/moa/tsconfig.json --noEmit && tsc -p packages/moa/tsconfig.client.json",
    "build": "node scripts/build.mjs",
    "pretest": "npm run build",
    "verify:package": "node scripts/verify-package.mjs",
    "test:launcher": "node --test tests/launcher/*.test.mjs"
  },
