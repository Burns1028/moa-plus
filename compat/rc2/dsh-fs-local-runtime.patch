+		if (!needed[0]) throw win32Error("GetTokenInformation", api.getLastError(), path);
+		const user = Buffer.alloc(needed[0]);
+		if (!api.getTokenInformation(token, 1, user, user.length, needed)) throw win32Error("GetTokenInformation", api.getLastError(), path);
