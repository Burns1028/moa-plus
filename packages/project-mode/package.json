  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-api-session-controller": {
      "optional": true
    },
    "@deepseek-ai/dsh-api-remote-access": {
      "optional": true
    },
    "@deepseek-ai/dsh-sandbox-policy": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent-preset-registry": {
      "optional": true
    },
    "@deepseek-ai/dsh-tool-executor-native": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.9.0"
  },
  "description": "Multi-agent collaboration for DeepSeek Harness: persistent agents, shared knowledge, direct communication, and independent review. Uses audited native compatibility profiles.",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh-plugin",
    "multi-agent",
    "ai-agents",
    "agent-orchestration",
    "typescript",
    "mixture-of-agents",
    "shared-memory"
  ],
  "icon": "./assets/icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-input-trigger"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Burns1028/moa-plus.git"
  },
  "homepage": "https://github.com/Burns1028/moa-plus#readme",
  "bugs": {
    "url": "https://github.com/Burns1028/moa-plus/issues"
  }
}
